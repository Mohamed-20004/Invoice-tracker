# PostgreSQL connection string (Railway provides this)
DATABASE_URL="postgresql://user:password@localhost:5432/invoice_tracker"

# Starling Bank personal access token (Developer Portal -> Personal Access; read-only scopes)
STARLING_PAT=""
# https://api.starlingbank.com for production, https://api-sandbox.starlingbank.com for sandbox
STARLING_API_BASE="https://api-sandbox.starlingbank.com"
# Shared secret from the Developer Portal webhook configuration
STARLING_WEBHOOK_SECRET=""

# argon2id hash of the admin password — generate with: npm run hash-password -- 'your-password'
ADMIN_PASSWORD_HASH=""
# Random 32+ byte secret for signing session cookies: openssl rand -base64 48
SESSION_SECRET=""

# Optional: explicit Chromium binary path for PDF rendering
# CHROMIUM_EXECUTABLE_PATH="/usr/bin/chromium"
