generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Settings {
  id                  Int     @id @default(1)
  companyName         String  @default("HH Plumbing & Gas LTD")
  companyNumber       String  @default("")
  registeredAddress   String  @default("167 Great Portland Street, London, W1W 5PF")
  placeOfRegistration String  @default("England and Wales")
  vatRegistered       Boolean @default(true)
  vatNumber           String  @default("516 1280 19")
  vatRatePercent      Int     @default(20)
  contactEmail        String  @default("office@hhplumbingandgas.com")
  contactPhone        String  @default("0208 102 1108")
  website             String  @default("hhplumbingandgas.com")
  bankAccountName     String  @default("HH Plumbing and Gas LTD")
  bankSortCode        String  @default("60-83-71")
  bankAccountNumber   String  @default("34428426")
  paymentTermsDays    Int     @default(14)
  nextInvoiceNumber   Int     @default(59)
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  VOID
}

model Invoice {
  id              String        @id @default(cuid())
  number          Int           @unique
  status          InvoiceStatus @default(DRAFT)
  // Customer details are written directly on the invoice — no separate
  // customer records to manage.
  customerName    String        @default("")
  customerAddress String        @default("") // multiline
  customerEmail   String?
  customerPhone   String?
  jobAddress     String?
  issueDate      DateTime      @default(now())
  dueDate        DateTime?
  supplyDate     DateTime?
  vatRegistered  Boolean       @default(false)
  vatRatePercent Int           @default(20)
  notes          String?
  lineItems      LineItem[]
  payments       Payment[]
  paidAt         DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model LineItem {
  id             String  @id @default(cuid())
  invoiceId      String
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  position       Int     @default(0)
  description    String
  quantity       Float   @default(1)
  unitPricePence Int     @default(0)
  included       Boolean @default(true)
}

enum MatchStatus {
  MATCHED
  UNMATCHED
  MANUAL
  IGNORED
}

model Payment {
  id                String      @id @default(cuid())
  feedItemUid       String      @unique
  amountPence       Int
  currency          String      @default("GBP")
  reference         String?
  counterPartyName  String?
  status            String
  source            String?
  transactionTime   DateTime
  matchStatus       MatchStatus @default(UNMATCHED)
  invoiceId         String?
  invoice           Invoice?    @relation(fields: [invoiceId], references: [id])
  rawJson           Json?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model LoginAttempt {
  id        String   @id @default(cuid())
  ip        String
  success   Boolean
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}
